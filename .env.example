# CraftPilot runtime agent (Rust) — keep this file private in production.
CRAFTPILOT_MASTER_URL=https://craftpilot.se

# Private state: node credential, enrollment request, heartbeat sequence.
CRAFTPILOT_AGENT_STATE_DIR=/var/lib/craftpilot-agent

# Server data root (used when lifecycle operations are implemented).
CRAFTPILOT_SERVER_DATA_ROOT=/srv/craftpilot/servers

# Command poll interval in seconds (5-120).
CRAFTPILOT_POLL_SECONDS=5

# Only for attaching an existing node; normal setup self-enrolls.
# CRAFTPILOT_NODE_ID=
# CRAFTPILOT_REGISTRATION_TOKEN=

# Agent image tag used by compose.yaml/compose.desktop.yaml (both are read
# with --env-file), so a new image needs no new Desktop build.
# CRAFTPILOT_RS_AGENT_IMAGE_TAG=0.14

# Log filter: info, debug, craftpilot_runtime_agent=debug, ...
RUST_LOG=info
