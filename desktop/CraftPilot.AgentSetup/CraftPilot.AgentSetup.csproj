<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CraftPilot.AgentSetup</AssemblyName>
    <RootNamespace>CraftPilot.AgentSetup</RootNamespace>
    <Version>0.17.0</Version>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\craftpilot.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testerna använder den interna konstruktorn med injicerade delar. -->
    <InternalsVisibleTo Include="CraftPilot.AgentSetup.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="wwwroot.index.html" />
    <EmbeddedResource Include="wwwroot\app.css" LogicalName="wwwroot.app.css" />
    <EmbeddedResource Include="wwwroot\app.js" LogicalName="wwwroot.app.js" />
    <EmbeddedResource Include="wwwroot\i18n.js" LogicalName="wwwroot.i18n.js" />
    <EmbeddedResource Include="Assets\craftpilot-icon.png" LogicalName="Assets.craftpilot-icon.png" />
    <EmbeddedResource Include="..\..\compose.desktop.yaml" LogicalName="compose.desktop.yaml" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_WebView2WpfReference Include="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <Reference Remove="@(_WebView2WpfReference)" />
    </ItemGroup>
  </Target>

</Project>
